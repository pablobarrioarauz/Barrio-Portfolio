---
// Portada: una foto a pantalla completa, en blanco y negro, que se pinta con
// su color al pasar el ratón. Cabecera arriba y pie abajo, encima de la foto.
import Base from '../layouts/Base.astro';
import LienzoPintable from '../components/LienzoPintable.astro';
import foto from '../assets/inicio/portada.jpg';
import fotoMovil from '../assets/inicio/portada-movil.jpg';
import { ambas, urlInicio, type Idioma } from '../lib/rutas';
import { sitio } from '../lib/sitio';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
---

<Base idioma={idioma} alternativas={ambas(urlInicio)} descripcion={t.inicioIntro} portada>
  {/* En ordenador, la textura del cuadro naranja del dormitorio de Núñez
      de Balboa (GG6A1628 del dossier, enderezada y a 3200 px). En el móvil
      (pantalla en vertical), Pablo pintando el cuadro amarillo («Barrio
      Julián Camarillo-12», la de siempre; unas horas del 25-11-2026 fue la
      -13, la mano en primer plano). Pedido de Guzmán, 25-11-2026. */}
  <LienzoPintable foto={foto} fotoVertical={fotoMovil} />
  <h1 class="oculto">{sitio.nombre} — {t.profesion}</h1>
</Base>

<style>
  /* El título existe para buscadores y lectores de pantalla, pero no se ve. */
  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
