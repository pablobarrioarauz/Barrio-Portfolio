---
// Encargos y Colabora conmigo: no son galerías, son para vender.
// Introducción, los pasos del proceso y un botón de WhatsApp con el mensaje
// ya escrito. Las dos páginas son iguales (Colabora conmigo es una réplica de
// Encargos, pedido de Guzmán, 21-10-2026); solo cambian los textos.
// Encargos es para particulares; Colabora conmigo, para negocios y espacios
// abiertos al público.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import fotoEncargosAncha from '../assets/encargos/horizontal.jpg';
import { ambas, urlColabora, urlEncargos, urlObra, type Idioma } from '../lib/rutas';
import { ficha, obrasDe } from '../lib/obras';
import { urlWhatsApp } from '../lib/sitio';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
  pagina?: 'encargos' | 'colabora';
}

const { idioma, pagina = 'encargos' } = Astro.props;
const t = textos[idioma];
const p =
  pagina === 'colabora'
    ? { nombre: t.colabora, url: urlColabora, intro: t.colaboraIntro, como: t.colaboraComo, pasos: t.colaboraPasos, mensaje: t.mensajeColabora }
    : { nombre: t.encargos, url: urlEncargos, intro: t.encargosIntro, como: t.encargosComo, pasos: t.encargosPasos, mensaje: t.mensajeEncargo };
// En ¿Colaboramos?, al final, los proyectos que ya ha hecho con otros
// (24-11-2026). Los añade, quita y ordena Pablo desde el panel; si no hay
// ninguno, la sección no sale.
// Cada una, un bloque como la cabecera de Encargos (pedido de Guzmán,
// 25-11-2026): la foto grande apaisada a un lado y, al otro, el nombre, con
// quién, dónde y cuándo, y el texto. Todo el bloque lleva a su página.
const colaboraciones = (pagina === 'colabora' ? await obrasDe('colaboraciones') : []).map((c) => {
  const f = ficha(c, idioma);
  return { url: urlObra('colaboraciones', c.id, idioma), ...f, portada: 'portada' in f ? f.portada : f.fotos[0] };
});
---

<Base idioma={idioma} alternativas={ambas(p.url)} titulo={p.nombre} descripcion={p.intro[0]} activa={pagina}>
  {/* Encargos lleva una foto apaisada 4:3 (pedido de Guzmán, 21-10-2026):
      en el móvil entre el título y el texto; en ordenador, a la derecha de
      los dos. Colabora conmigo, sin foto. */}
  <div class:list={['cabeza', { 'con-foto': pagina === 'encargos' }]}>
    <h1 class="anima" data-ritmo="45">{p.nombre}</h1>
    {pagina === 'encargos' && (
      <figure class="foto anima-bloque">
        <Image src={fotoEncargosAncha} alt="" widths={[600, 900, 1200, 1600]} sizes="(min-width: 900px) 50vw, 100vw" loading="eager" fetchpriority="high" />
      </figure>
    )}
    <div class="texto-largo">
      {p.intro.map((parrafo) => <p class="anima-parrafo">{parrafo}</p>)}
    </div>
  </div>

  {/* Encargos: los pasos del proceso. ¿Colaboramos?: las modalidades de
      colaboración (texto de Pablo, 24-11-2026), cada una con a quién va. Una
      columna por tarjeta en ordenador, para que no quede un hueco. */}
  <h2 class="anima" data-ritmo="30">{p.como}</h2>
  <ol class="pasos" style={`--columnas: ${p.pasos.length}`}>
    {p.pasos.map((paso, i) => (
      <li>
        <span class="numero anima" data-ritmo="45" data-despues={i * 120}>{String(i + 1).padStart(2, '0')}</span>
        <h3 class="anima" data-ritmo="25" data-despues={i * 120 + 100}>{paso.titulo}</h3>
        {'para' in paso && <p class="para anima-parrafo" data-despues={i * 120 + 180}>{paso.para}</p>}
        <p class="anima-parrafo" data-despues={i * 120 + 250}>{paso.texto}</p>
      </li>
    ))}
  </ol>

  <p class="llamada anima-bloque"><a class="boton" href={urlWhatsApp(p.mensaje)}>{t.escribirWhatsApp}</a></p>

  {colaboraciones.length > 0 && (
    <section class="colaboraciones">
      <h2 class="anima" data-ritmo="30">{t.colaboraciones}</h2>
      <ul class="lista-colaboraciones">
        {colaboraciones.map((c) => (
          <li class="anima-bloque">
            <a class="colaboracion" href={c.url}>
              <figure class="foto">
                <Image src={c.portada} alt={c.titulo} widths={[600, 900, 1200, 1600]} sizes="(min-width: 900px) 50vw, 100vw" />
              </figure>
              <div class="sobre">
                <h3>{c.titulo}</h3>
                <p class="datos">{c.datos.map((d) => d.texto).join(' · ')}</p>
                {c.texto && <p class="texto">{c.texto}</p>}
                <span class="ver">{t.verProyecto} →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<script is:inline>
  // Los textos esperan escondidos hasta hacer su entrada (ver abajo), salvo
  // si no se puede o se ha pedido menos movimiento.
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches)
    document.documentElement.classList.add('encargos-anima');
</script>

<script>
  // Entradas, como el título de Pintura y Escultura (pedido de Guzmán): los
  // títulos entran letra a letra, cada letra subiendo un poco y pasando de
  // desenfocada a nítida; el ritmo (ms entre letras) va en data-ritmo. Los
  // párrafos entran enteros, de una vez, subiendo y fundiéndose, sin
  // desenfoque: letra a letra eran cientos de piezas animándose a la vez con
  // desenfoque, demasiado pesado (Guzmán lo notó). data-despues retrasa una
  // pieza respecto a las de su grupo (las tarjetas, una tras otra). La foto
  // y el botón aparecen subiendo apenas. Cada cosa entra al llegar a la
  // pantalla, una sola vez; las que se ven al abrir, en orden.
  if (document.documentElement.classList.contains('encargos-anima')) {
    for (const el of document.querySelectorAll<HTMLElement>('.anima')) {
      const texto = el.textContent!.trim();
      el.setAttribute('aria-label', texto);
      el.replaceChildren(
        ...texto.split(' ').flatMap((palabra, k, todas) => {
          const caja = document.createElement('span');
          caja.className = 'palabra';
          caja.setAttribute('aria-hidden', 'true');
          for (const letra of palabra) {
            const l = document.createElement('span');
            l.className = 'letra';
            l.textContent = letra;
            caja.append(l);
          }
          return k < todas.length - 1 ? [caja, document.createTextNode(' ')] : [caja];
        }),
      );
    }
    let cola = 0; // las que entran juntas, en orden
    let tanda = 0;
    const entrar = (el: HTMLElement) => {
      const ahora = performance.now();
      if (ahora - tanda > 100) cola = 0;
      tanda = ahora;
      const base = cola + Number(el.dataset.despues ?? 0);
      if (el.classList.contains('anima')) {
        const ritmo = Number(el.dataset.ritmo ?? 10);
        el.querySelectorAll<HTMLElement>('.letra').forEach((l, i) => (l.style.animationDelay = `${base + i * ritmo}ms`));
        if (!el.dataset.despues) cola += Math.min(500, el.querySelectorAll('.letra').length * ritmo * 0.5);
      } else {
        el.style.animationDelay = `${base}ms`;
        if (el.classList.contains('anima-parrafo') && !el.dataset.despues) cola += 120;
      }
      el.classList.add('visto');
    };
    const ver = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          entrar(e.target as HTMLElement);
          ver.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    const pendientes = [...document.querySelectorAll<HTMLElement>('.anima, .anima-bloque, .anima-parrafo')];
    pendientes.forEach((el) => ver.observe(el));
    // Si se salta de golpe por encima de algo (sin que llegue a verse), el
    // vigilante no se entera: al hacer scroll se repasa lo que haya quedado
    // ya por encima de la pantalla.
    addEventListener(
      'scroll',
      () => {
        for (const el of pendientes) {
          if (el.classList.contains('visto') || !el.offsetWidth) continue;
          if (el.getBoundingClientRect().bottom < 0) {
            entrar(el);
            ver.unobserve(el);
          }
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  /* ---------- Entradas (ver el script) ---------- */
  :global(html.encargos-anima) .anima:not(.visto),
  :global(html.encargos-anima) .anima-bloque:not(.visto),
  :global(html.encargos-anima) .anima-parrafo:not(.visto) {
    opacity: 0;
  }

  .anima :global(.palabra) {
    display: inline-block;
    white-space: nowrap;
  }

  .anima :global(.letra) {
    display: inline-block;
  }

  .anima.visto :global(.letra) {
    animation: letra 1.1s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }

  @keyframes letra {
    from {
      opacity: 0;
      transform: translateY(0.45em);
      filter: blur(6px);
    }
  }

  /* Los párrafos, enteros: solo opacidad y movimiento, que el navegador
     anima sin esfuerzo. */
  .anima-parrafo.visto {
    animation: parrafo 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }

  @keyframes parrafo {
    from {
      opacity: 0;
      translate: 0 0.8em;
    }
  }

  .anima-bloque.visto {
    animation: bloque 1.1s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }

  @keyframes bloque {
    from {
      opacity: 0;
      translate: 0 1rem;
      filter: blur(6px);
    }
  }

  .foto {
    margin: 0 0 1.5rem;
    overflow: hidden;
    background: var(--vacio);
  }

  .foto :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /* En ordenador, la foto (4:3, el formato de la web girado) a la
     derecha, y el título y el texto centrados en vertical frente a ella,
     para que los dos bloques pesen lo mismo. */
  @media (min-width: 900px) {
    .foto {
      margin: 0;
    }
    .cabeza.con-foto {
      display: grid;
      grid-template-columns: 5fr 6fr;
      grid-template-rows: auto auto;
      align-content: center;
      column-gap: clamp(2rem, 5vw, 5rem);
      margin-top: 0.5rem;
    }
    .con-foto h1,
    .con-foto .texto-largo {
      grid-column: 1;
    }
    .con-foto h1 {
      align-self: end;
      margin-top: 0;
    }
    .con-foto .texto-largo {
      align-self: start;
    }
    .con-foto .texto-largo p:last-child {
      margin-bottom: 0;
    }
    .con-foto .foto {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }

  h2 {
    margin: 3rem 0 1.5rem;
  }

  /* Los pasos, en tarjetas como las cajitas del menú (gris claro, esquinas
     de 4 px), todas del mismo alto: el número arriba en la serif y, más
     abajo y a la misma altura en todas, el título y el texto. Pedido de
     Guzmán, 21-10-2026. */
  .pasos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--hueco);
  }

  @media (min-width: 720px) {
    .pasos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .pasos {
      grid-template-columns: repeat(var(--columnas, 4), 1fr);
    }
  }

  .pasos li {
    display: flex;
    flex-direction: column;
    padding: 1.1rem 1.2rem 1.3rem;
    border-radius: 4px;
    background: rgb(237 237 237 / 0.6);
  }

  .numero {
    font-family: var(--serif);
    font-size: calc(0.9em * var(--serif-escala));
    color: var(--suave);
  }

  h3 {
    margin: 2rem 0 0.5rem;
  }

  @media (min-width: 720px) {
    .pasos li {
      min-height: 14rem;
    }
    h3 {
      margin-top: 4.5rem;
    }
  }

  .pasos p {
    margin: 0;
    color: var(--suave);
  }

  .pasos .para {
    margin-bottom: 0.75rem;
    color: var(--texto);
    font-style: italic;
  }

  .llamada {
    margin-top: 3rem;
  }

  .colaboraciones {
    margin-top: 5rem;
  }

  .lista-colaboraciones {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4rem;
  }

  .colaboracion {
    display: grid;
    gap: 1.25rem;
    color: inherit;
    text-decoration: none;
  }

  .colaboracion .foto {
    margin: 0;
  }

  .colaboracion .foto :global(img) {
    transition: scale 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .colaboracion:hover .foto :global(img) {
    scale: 1.03;
  }

  .colaboracion h3 {
    margin: 0 0 0.5rem;
  }

  .colaboracion .datos,
  .colaboracion .texto {
    margin: 0 0 0.75rem;
    color: var(--suave);
  }

  .colaboracion .ver {
    display: inline-block;
    margin-top: 0.5rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* En ordenador, como la cabecera de Encargos: el texto a la izquierda,
     centrado en vertical, y la foto a la derecha. En el móvil, la foto
     arriba. */
  @media (min-width: 900px) {
    .colaboracion {
      grid-template-columns: 5fr 6fr;
      align-items: center;
      column-gap: clamp(2rem, 5vw, 5rem);
    }
    .colaboracion .foto {
      order: 2;
    }
  }
</style>
